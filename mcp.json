{
  "mcpServers": {
    "memfuse": {
      "command": "cargo",
      "args": [
        "run",
        "--release",
        "--bin",
        "memfuse-mcp-server",
        "--",
        "--db-path",
        "./memfuse_data"
      ],
      "env": {
        "MEMFUSE_OLLAMA_URL": "http://localhost:11434",
        "MEMFUSE_EMBED_MODEL": "nomic-embed-text"
      }
    }
  }
}
